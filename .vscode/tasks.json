{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\cmake.exe --build build --config Release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\cmake.exe -S . -B build -G \"MinGW Makefiles\" -DCMAKE_BUILD_TYPE=Release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}